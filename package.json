{
  "name": "teslo-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:deploy && next build",
    "start": "next start",
    "lint": "eslint .",
    "prisma:deploy": "prisma migrate deploy && prisma generate",
    "seed": "ts-node src/seed/seed-database.ts",
    "typecheck": "prisma generate && next typegen && tsc --noEmit --incremental false",
    "build:check": "prisma generate && next build",
    "check:db": "node scripts/check-db.mjs",
    "test": "tsx --test tests/security.test.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs"
  },
  "prettier": {
    "singleQuote": true
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^8.3.0",
    "@prisma/client": "6.19.3",
    "@vercel/analytics": "^1.3.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.403.0",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.51.5",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^5.2.1",
    "react-loading-skeleton": "^3.4.0",
    "swiper": "^12.2.0",
    "tailwind-merge": "^2.4.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@next/env": "^16.4.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
